#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1

extra_command "pair" "Show the pairing token and attempt; 'pair confirm|cancel [player]' answers it"

PROG=/usr/bin/sendspin-cli
RUN_DIR=/var/run/sendspin-cli

validate_player_section() {
	uci_load_validate sendspin-cli player "$1" "$2" \
		'enabled:bool:0' \
		'name:string' \
		'device:string:hw:0,0' \
		'input:string' \
		'audio_format:string' \
		'buffer_ms:range(10,2000):100' \
		'output_delay:uinteger:0' \
		'port:port:8928' \
		'mdns:bool:1' \
		'allow_unpaired:bool:0' \
		'server:string' \
		'log_level:or("none","error","warn","info","debug","verbose"):info' \
		'state_dir:string:/etc/sendspin-cli'
}

# The /proc/asound directory of the capture device an ALSA input names, such
# as default, hw:1,0 or plughw:CARD=Device,DEV=0. Fails for anything else,
# which is left for the player to judge.
input_capture_dir() {
	local spec="${1#alsa:}" args card dev=0 field position=0

	case "$spec" in
	default | sysdefault)
		# default can be redefined there, as anything at all
		[ -e /etc/asound.conf ] && return 1
		card=0
		;;
	hw:* | plughw:* | sysdefault:* | dsnoop:*)
		args="${spec#*:}"
		local IFS=,
		for field in $args; do
			case "$field" in
			CARD=*) card="${field#CARD=}" ;;
			DEV=*) dev="${field#DEV=}" ;;
			*=*) ;;
			*)
				[ "$position" = 0 ] && card="$field"
				[ "$position" = 1 ] && dev="$field"
				;;
			esac
			position=$((position + 1))
		done
		;;
	*) return 1 ;;
	esac

	case "${card:-0}" in
	*[!0-9]*) echo "/proc/asound/$card/pcm${dev}c" ;;
	*) echo "/proc/asound/card${card:-0}/pcm${dev}c" ;;
	esac
}

start_player() {
	local capture_dir missing_input

	[ "$2" = 0 ] || {
		echo "validation failed"
		return 1
	}

	[ "$enabled" = 1 ] || return 0

	[ -n "$name" ] || name="$(cat /proc/sys/kernel/hostname)"

	# The player refuses to start on an input it cannot open, and would take
	# playback down with it, so a missing card only costs the input. The
	# sound hotplug script starts the player again once the card appears.
	if [ -n "$input" ] && capture_dir="$(input_capture_dir "$input")" && [ ! -d "$capture_dir" ]; then
		logger -t sendspin-cli "$1: no capture device for input '$input'; playing without it until one appears"
		missing_input="$capture_dir"
		input=""
	fi

	mkdir -p "$state_dir" "$RUN_DIR"
	chown sendspin:audio "$state_dir" "$RUN_DIR"

	procd_open_instance "$1"
	procd_set_param command "$PROG" \
		--name "$name" \
		--output "$device" \
		--buffer-ms "$buffer_ms" \
		--output-delay "$output_delay" \
		--port "$port" \
		--log-level "$log_level" \
		--state-dir "$state_dir" \
		--control-socket "$RUN_DIR/$1.sock" \
		--no-mdns
	[ -n "$input" ] && procd_append_param command --input "$input"
	[ -n "$audio_format" ] && procd_append_param command --audio-format "$audio_format"
	[ "$allow_unpaired" = 1 ] && procd_append_param command --allow-unpaired

	# One data table for both, since each would otherwise add its own
	procd_open_data
	[ -n "$missing_input" ] && json_add_string input_missing "$missing_input"

	# The player is built without mDNS; umdns announces it instead
	if [ -n "$server" ]; then
		procd_append_param command --server "$server"
	elif [ "$mdns" = 1 ]; then
		procd_add_mdns "sendspin" "tcp" "$port" "path=/sendspin" "name=$name"
	fi
	procd_close_data

	procd_set_param user sendspin
	procd_set_param group audio
	procd_set_param nice -10
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load sendspin-cli
	config_foreach validate_player_section player start_player
}

# The player says goodbye with reason 'shutdown' whenever it stops, and a
# server takes that at its word: it reconnects only once mDNS announces the
# player again. umdns announces a service when it appears and withdraws it when
# it disappears, but a restart that swaps it for an identical one does neither.
# So withdraw the announcement once the player has actually exited; umdns
# announces it again a few seconds after it starts. A configuration reload is
# a full restart for the same reason.
service_stopped() {
	local wait=10

	while procd_running sendspin-cli && [ "$wait" -gt 0 ]; do
		sleep 1
		wait=$((wait - 1))
	done
	ubus -t 2 call umdns reload > /dev/null 2>&1
}

reload_service() {
	restart
}

# What a server needs to pair: the code a pairing attempt shows while it
# runs, or the token to paste.
pair_player() {
	local socket="$RUN_DIR/$1.sock" status code

	[ -z "$3" ] || [ "$3" = "$1" ] || return 0

	if [ ! -S "$socket" ]; then
		echo "$1: not running"
		return 0
	fi

	# confirm also opens the window ahead of an attempt, like a button
	if [ "$2" = confirm ]; then
		"$PROG" pair confirm --control-socket "$socket" &&
			echo "$1: a server may pair for the next 5 minutes"
		return 0
	elif [ "$2" = cancel ]; then
		"$PROG" pair cancel --control-socket "$socket" &&
			echo "$1: pairing refused"
		return 0
	fi

	status="$("$PROG" status --control-socket "$socket")" || return 0
	code="$(echo "$status" | sed -n 's/^pairing code: //p')"

	echo "$1:"
	[ -z "$code" ] || echo "  pairing code: $code (enter it in the server)"
	echo "$status" | grep -E '^(name|server|trust|pairing window):' | sed 's/^/  /'
	printf '  pairing token: '
	"$PROG" pair-token --control-socket "$socket"
}

pair() {
	case "$1" in
	confirm | cancel)
		config_load sendspin-cli
		config_foreach pair_player player "$1" "$2"
		;;
	"")
		config_load sendspin-cli
		config_foreach pair_player player "" ""
		;;
	*)
		echo "usage: $initscript pair [confirm|cancel] [player]"
		return 1
		;;
	esac
}

service_triggers() {
	procd_add_reload_trigger sendspin-cli
	procd_add_validation validate_player_section
}
